# /opt/apps/klinik/.env  — dibuat oleh Ansible (role app_host) bila belum ada.
# Permission 600. Jangan commit file .env asli.
#
# PENTING: password dipakai di URL postgres://, jadi gunakan karakter aman URL
# (huruf + angka), mis.:  openssl rand -hex 24

# ---- database ----
POSTGRES_USER=klinik
POSTGRES_DB=klinik
POSTGRES_PASSWORD=ganti-dengan-hex-acak
# DB_BIND_PORT=5432           # port Postgres di 127.0.0.1 server

# ---- api ----
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
APP_NAME=Klinik RME
TZ=Asia/Jakarta
# Origin FE yang boleh akses API (pisahkan koma). Bila FE & API satu domain via nginx, isi URL FE.
CORS_ORIGINS=http://192.168.1.10
# true bila sudah HTTPS
COOKIE_SECURE=false
# MAX_UPLOAD_MB=10
# RATE_LIMIT_RPM=600

# ---- web ----
WEB_PORT=80
# WEB_BIND=127.0.0.1          # pakai ini bila di depan ada reverse proxy (Caddy/Traefik/nginx host)
# NGINX_MAX_BODY=20m

# ---- image (diisi otomatis oleh Jenkins / deploy.sh) ----
API_IMAGE=
WEB_IMAGE=
# ATLAS_IMAGE=arigaio/atlas:1.4.0
# POSTGRES_IMAGE=postgres:17-alpine
